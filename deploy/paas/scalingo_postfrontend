#!/bin/bash

set -o errexit    # always exit on error
set -o pipefail   # don't ignore exit codes when piping output

echo "-----> Running post-frontend script"

# --- Mobile OTA: stage the signed bundle -------------------------------------
# Upload the just-built dist as an OTA bundle + immutable release metadata, but
# do NOT touch the channel manifest: the deploy can still fail after this hook
# (python buildpack, container boot), and the manifest must never point at a
# version that is not actually serving. The flip happens at postdeploy
# (deploy/paas/scalingo_ota_promote.py), which Scalingo only runs on a
# successful deployment — redeploying an old commit re-flips the manifest
# backward, which is the sanctioned OTA rollback (docs/mobile.md).
#
# Gated on MOBILE_OTA_S3_BUCKET (the first variable otaConfig() requires, with
# no default): unset means "this app has no OTA bucket" and the whole block is
# skipped. Set, every other required variable must be present — a half-done
# configuration must fail the build loudly, not publish something broken.
if [ -n "${MOBILE_OTA_S3_BUCKET:-}" ]; then
  # MOBILE_OTA_SIGNING_PUBLIC_KEY_B64 is not used here but MUST have been
  # inlined into the vite build (envPrefix): ota.ts refuses any update when the
  # running bundle embeds no verification key, so publishing a key-less bundle
  # would strand every device that applies it. This hook is the last barrier
  # before publication.
  for v in MOBILE_OTA_S3_ENDPOINT MOBILE_OTA_S3_ACCESS_KEY MOBILE_OTA_S3_SECRET_KEY \
           MOBILE_OTA_CHANNEL MOBILE_OTA_PUBLIC_BASE_URL \
           MOBILE_OTA_SIGNING_PRIVATE_KEY_B64 MOBILE_OTA_SIGNING_PUBLIC_KEY_B64 \
           SOURCE_VERSION; do
    [ -n "${!v:-}" ] || { echo "OTA enabled (MOBILE_OTA_S3_BUCKET set) but $v is missing" >&2; exit 1; }
  done
  # Bare short sha, the same id `make mobile-build` stamps into the builtin
  # bundle (Makefile pins `git rev-parse --short=8` precisely so both sides
  # produce identical strings).
  OTA_VERSION="${SOURCE_VERSION:0:8}"
  echo "-----> Staging OTA bundle ${OTA_VERSION} (channel ${MOBILE_OTA_CHANNEL})"
  (cd src/frontend && node scripts/publish-ota.mjs --stage-only \
     --version "$OTA_VERSION" --channel "$MOBILE_OTA_CHANNEL" --dist ./dist)
  # Marker consumed by the postdeploy flip; build/ survives scalingo_postcompile.
  # Written only after a successful stage, so the flip can trust its content.
  mkdir -p build/
  printf '%s %s\n' "$OTA_VERSION" "$MOBILE_OTA_CHANNEL" > build/ota-release-id
elif [ -n "${MOBILE_OTA_CHANNEL:-}${MOBILE_OTA_PUBLIC_BASE_URL:-}${MOBILE_OTA_SIGNING_PRIVATE_KEY_B64:-}" ]; then
  echo "Partial OTA config: MOBILE_OTA_* vars set without MOBILE_OTA_S3_BUCKET" >&2
  exit 1
fi
# -----------------------------------------------------------------------------

# Move the frontend build to the app root and clean up
mkdir -p build/
mv src/frontend/dist build/frontend-out

mv src/backend/* ./
mkdir -p messages_backend && touch messages_backend/__init__.py

# Download Caddy binary
CADDY_VERSION="2.9.1"
curl -fsSL "https://github.com/caddyserver/caddy/releases/download/v${CADDY_VERSION}/caddy_${CADDY_VERSION}_linux_amd64.tar.gz" | tar -xz -C bin/ caddy
chmod +x bin/caddy

# Copy Caddyfile (uses {$ENV} vars natively, no ERB needed)
cp src/frontend/caddy/Caddyfile ./Caddyfile

echo "3.14" > .python-version
