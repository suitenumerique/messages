# Keep the build context to what the images actually need.
#
# Without this every build ships whatever the host left lying around. The
# distroless pymta image was carrying __pycache__ directories generated on a
# developer's machine: stale, unreproducible, and bytecode nobody audited.

# Host-generated bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local virtualenvs, never the one the image uses
.venv/
venv/

# Tests and fixtures. The dev image bind-mounts the source tree, so it sees
# these from the mount; no image needs them baked in.
tests/

# Docs and build metadata
README.md
*.md
