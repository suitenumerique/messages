<?xml version='1.0' encoding='utf-8'?>
<resources>
    <!-- app_name / title_activity_main are resValues driven by MOBILE_APP_NAME
         (see app/build.gradle); defining them here too would clash. -->
    <string name="package_name">local.suitenumerique.messages</string>
    <string name="custom_url_scheme">local.suitenumerique.messages</string>

    <!-- Generic push banner: a push without a preview carries only these
         localization keys (core/services/push/fcm.py, FCM_TITLE_LOC_KEY /
         FCM_BODY_LOC_KEY) and the OS renders the strings from here even when
         the app is killed; PushPreviewMessagingService falls back to them when
         a preview can't be decrypted. Keep in sync with the iOS
         Localizable.strings NEW_MESSAGE entry. -->
    <string name="new_message_title">Messages</string>
    <string name="new_message_body">New message</string>
    <!-- Mirror of the channel name the web app gives (features/native/push.ts),
         used when the service has to recreate the channel. -->
    <string name="new_messages_channel_name">New messages</string>
</resources>
