# The default hoisted layout is deliberate: `install-strategy=linked` was tried
# and reverted. It installs packages under `node_modules/.store/<pkg>@<version>-
# <hash>/` and symlinks them, and that `<hash>` is install-local — so the paths
# the Capacitor CLI resolves and bakes into the *committed* native project files
# (Package.swift, capacitor.settings.gradle) stopped being valid on any other
# machine, breaking the iOS and Android builds.
#
# It bought little in return: the lockfile (which describes the hoisted tree)
# carries 1750 entries for 1549 unique package/version pairs, so the layout
# deduplicates 419 copies — almost all of them micro-packages (type-fest, semver,
# ms, p-limit…), a few dozen MB against a ~1.1 GB tree. The real shrink came from
# package.json "overrides" and from dropping @adobe/react-spectrum, both of which
# work regardless of the install strategy.

# Supply-chain cooldown: only resolve package versions that have been public for
# at least this many DAYS (npm >= 11.16). Blunts "publish malware, get pulled in
# instantly" attacks by refusing brand-new releases when the tree is (re)resolved
# at `npm install` time. Frozen `npm ci` installs the already-vetted lockfile as
# is. Complements the check:deps guardrail (scripts/check-node-modules.mjs).
min-release-age=1
