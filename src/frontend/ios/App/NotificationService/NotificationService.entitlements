<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Read access to the notification preview keys the app generates
	  (PushPreviewKeyring). Must list the same group as App.entitlements.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(PUSH_PREVIEW_KEYCHAIN_GROUP)</string>
	</array>
</dict>
</plist>
